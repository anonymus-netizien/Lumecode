# Lumecode Environment Configuration
# Copy this file to .env and fill in your API keys

# ===========================================
# LLM Provider API Keys (in priority order)
# ===========================================

# Google Gemini (Primary - Free tier available)
GOOGLE_API_KEY=

# OpenRouter (Secondary - Free models available)
OPENROUTER_API_KEY=

# Groq (Tertiary - Free tier available)
GROQ_API_KEY=

# ===========================================
# Optional Providers
# ===========================================

# Ollama (Local - Always free)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (Paid)
OPENAI_API_KEY=

# Anthropic Claude (Paid)
ANTHROPIC_API_KEY=

# ===========================================
# Application Settings
# ===========================================

# Default provider to use (gemini, openrouter, groq, ollama)
LUMECODE_DEFAULT_PROVIDER=gemini

# Default model for each provider
LUMECODE_GEMINI_MODEL=gemini-2.0-flash-exp
LUMECODE_OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
LUMECODE_GROQ_MODEL=llama-3.3-70b-versatile

# Log level (debug, info, warn, error)
LUMECODE_LOG_LEVEL=info

# Session storage path
LUMECODE_DATA_DIR=~/.lumecode

# Enable telemetry (false for privacy)
LUMECODE_TELEMETRY=false
